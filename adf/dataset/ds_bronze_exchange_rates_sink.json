                "fileName": {
                    "value": "@dataset().file_name",
                    "type": "Expression"
                },
                "folderPath": {
                    "value": "@concat('ExchangeRates/ingestion_date=', formatDateTime(utcNow(), 'yyyy-MM-dd'))",
                    "type": "Expression"
                },
                "fileSystem": "bronze"
            }
        }
    }
}
