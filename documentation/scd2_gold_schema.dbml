// Gold dimension of the CDC demo (gold/cdc/) and the incremental file load (gold/incremental/): only the current
// state, the history (valid_from / valid_to / is_current) stays in Silver (documentation/cdc.md,
// documentation/incremental_load.md). Paste into https://dbdiagram.io.
// Column order = CURRENT_DIM_VEHICLE_COLUMNS in notebooks/utils/gold_helpers.py (tests/test_cdc_pipeline.py compares
// them): the main gold.dim_vehicle without has_service_history (these demos have no service book).

Table dim_vehicle {
  vehicle_key bigint [pk, note: 'xxhash64(vehicle_id), the same key as in the main gold.dim_vehicle; -1 = Unknown']
  vehicle_id varchar
  vin varchar
  manufacture_year int
  manufacturer varchar
  model varchar
  manufacturer_source varchar
  condition varchar
  cylinders int
  fuel varchar
  transmission varchar
  drive varchar
  size varchar
  body_type varchar
  paint_color varchar
  title_status varchar
  listing_url varchar
  Note: 'One row per vehicle that exists now (Silver WHERE is_current); SCD Type 1, rebuilt on every run'
}
